{
  "name": "qwellness-ai-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix frontend install && pip install -r backend/requirements.txt",
    "setup:api": "pip install -r backend/requirements.txt",
    "seed": "cd backend && python seed.py",
    "reset-demo": "cd backend && python reset_demo.py",
    "api": "npm --prefix frontend run api",
    "dev": "npm --prefix frontend run dev",
    "dev:all": "npm --prefix frontend run dev:all",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "typecheck": "npm --prefix frontend run typecheck"
  }
}