# --- Groq (required for the AI features). Get a key at https://console.groq.com/keys, then restart the backend.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b


# --- Provider switches (mock = works out of the box)
BOOKING_PROVIDER=mock
SOCIAL_PROVIDER=mock
MESSAGING_PROVIDER=mock
TELEPHONY_PROVIDER=browser

# --- Jane App (needs partner API access)
JANE_API_BASE=https://qwellnessclinic.janeapp.com
JANE_API_KEY=

# --- Meta (Facebook Page + Instagram Business; needs Meta app review)
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=

# --- Twilio / Vapi / Retell
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
VAPI_API_KEY=
